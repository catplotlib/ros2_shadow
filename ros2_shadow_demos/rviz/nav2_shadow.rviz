Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 400
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.65
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Name: Start / Goal
      Enabled: true
      Topic:
        Value: /shadow/waypoints
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Namespaces:
        waypoints: true
    - Class: rviz_default_plugins/Path
      Name: Production
      Enabled: true
      Alpha: 1
      Color: 60; 220; 120
      Line Style: Billboards
      Line Width: 0.30
      Buffer Length: 1
      Offset: {X: 0, Y: 0, Z: 0}
      Pose Style: None
      Topic:
        Value: /planner/path
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Name: Candidate
      Enabled: true
      Alpha: 1
      Color: 255; 90; 90
      Line Style: Billboards
      Line Width: 0.30
      Buffer Length: 1
      Offset: {X: 0, Y: 0, Z: 0}
      Pose Style: None
      Topic:
        Value: /shadow/planner/path
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
  Global Options:
    Background Color: 24; 25; 28
    Fixed Frame: map
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 15
      Target Frame: map
      X: 0
      Y: 0
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
  QMainWindow State: ""
